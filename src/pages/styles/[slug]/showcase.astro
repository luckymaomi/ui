---
import { ShowcaseLoader } from "@/components/showcases/ShowcaseLoader";
import DeferredStylesheet from "@/components/site/DeferredStylesheet.astro";
import { showcaseTypography, styles } from "@/content/catalog";
import { withBase } from "@/lib/base";
import "@/styles/runtime.css";

export function getStaticPaths() {
  return styles.map((style) => ({ params: { slug: style.slug }, props: { style } }));
}
const { style } = Astro.props;
const typography = showcaseTypography.find((item) => item.slug === style.slug)?.profile ?? null;
const bodyStyle = typography
  ? `margin:0;--font-display-active:${typography.displayStack};--font-body-active:${typography.bodyStack};--font-mono-active:${typography.monoStack}`
  : "margin:0";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`${style.name}真实交互展示`} />
    <link rel="icon" type="image/svg+xml" href={withBase("/icon.svg")} />
    <link rel="stylesheet" href={withBase(`/_route-css/showcase/${style.slug}.css`)} />
    <title>{style.name}真实展示 | UI</title>
    {typography && <DeferredStylesheet href={typography.stylesheetUrl} profileId={typography.id} />}
  </head>
  <body class="showcase-page" data-showcase-font={typography?.id} style={bodyStyle}>
    <ShowcaseLoader slug={style.slug} client:only="react" />
  </body>
</html>
