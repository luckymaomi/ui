---
import { styles } from "@/content/catalog";
import { withBase } from "@/lib/base";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="组件配方">
  <header class="page-intro"><h1>组件配方</h1></header>
  <section class="domain-section">
    <div class="compact-grid recipe-index">
      {styles.map((style) => (
        <a class="compact-item" href={withBase(`/recipes/${style.slug}/`)}>
          <div><h2>{style.name}</h2><p>{style.nameEn}</p></div>
          <span>{Object.keys(style.recipe.recipes).length} 个组件配方</span>
          <div class="mini-palette">{[style.colors.primary, style.colors.secondary, ...style.colors.accent.slice(0, 3)].map((color) => <i style={`background:${color}`}></i>)}</div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
